generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  INTEGRATOR
  VIEWER
}

enum ProjectStatus {
  DRAFT
  SURVEY
  QUOTED
  IN_PROGRESS
  DELIVERED
  ARCHIVED
}

enum ProjectMemberRole {
  OWNER
  PROJECT_MANAGER
  TECHNICIAN
  VIEWER
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model User {
  id                 String          @id @default(cuid())
  name               String?
  email              String          @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  role               Role            @default(INTEGRATOR)
  active             Boolean         @default(true)
  accounts           Account[]
  sessions           Session[]
  ownedProjects      Project[]       @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  historyEntries     ProjectHistory[]
  notifications      Notification[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model CompanySettings {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  siret     String?
  email     String?
  phone     String?
  website   String?
  address   String?
  city      String?
  postalCode String?
  country   String   @default("France")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  contacts  Contact[]
  sites     Site[]
  projects  Project[]
  studies   Study[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  jobTitle  String?
  email     String?
  phone     String?
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Site {
  id          String    @id @default(cuid())
  name        String
  address     String
  city        String
  postalCode  String
  country     String    @default("France")
  latitude    Float?
  longitude   Float?
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Project {
  id          String           @id @default(cuid())
  reference   String           @unique
  name        String
  description String?
  status      ProjectStatus    @default(DRAFT)
  clientId    String
  siteId      String
  ownerId     String
  client      Client           @relation(fields: [clientId], references: [id])
  site        Site             @relation(fields: [siteId], references: [id])
  owner       User             @relation("ProjectOwner", fields: [ownerId], references: [id])
  members     ProjectMember[]
  history     ProjectHistory[]
  studies     Study[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(TECHNICIAN)
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([projectId, userId])
}

model ProjectHistory {
  id        String   @id @default(cuid())
  projectId String
  userId    String?
  action    String
  details   String?
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType @default(INFO)
  readAt    DateTime?
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
}

enum StudyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Study {
  id          String         @id @default(cuid())
  name        String
  description String?
  status      StudyStatus    @default(DRAFT)
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions    StudyVersion[]
  files       StudyFile[]
  layers      StudyLayer[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model StudyVersion {
  id        String   @id @default(cuid())
  studyId   String
  study     Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  number    Int
  snapshot  Json
  createdAt DateTime @default(now())

  @@unique([studyId, number])
}

model StudyFile {
  id           String   @id @default(cuid())
  studyId      String
  study        Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  originalName String
  mimeType     String
  size         Int
  storageKey   String
  url          String
  createdAt    DateTime @default(now())
}

model StudyLayer {
  id        String   @id @default(cuid())
  studyId   String
  study     Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  name      String
  visible   Boolean  @default(true)
  locked    Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
